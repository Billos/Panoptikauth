# Server configuration
PORT=3000
LOCALE=fr-FR
TZ=Europe/Paris

# Redis configuration
REDIS_URL=redis://redis:6379

# Gotify configuration (used by cron jobs)
GOTIFY_URL=https://gotify.example.com
GOTIFY_TOKEN=your-gotify-token

# fail2ban cron schedule (default: every 5 minutes)
FAIL2BAN_CRON=*/5 * * * *